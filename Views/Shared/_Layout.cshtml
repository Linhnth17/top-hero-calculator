<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Thí Luyện · Top Heroes Tool</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&display=swap&subset=vietnamese" rel="stylesheet">
  <style>
    /* Phong cách giao diện game: giấy da kem, viền gỗ nâu, băng tiêu đề cam, nút nổi 3D */
    :root{
      --bg:#1d2a55; --panel:#f1dfb8; --surface:#fbf3e0; --surface-2:#f4e4c1; --text:#4a2c12; --muted:#86643f; --line:#d9b98a;
      --frame:#8a5a2b; --frame-dark:#5a3816;
      --accent:#e8841f; --accent-weak:#fde3b8; --accent-text:#fff;
      --ok:#3a8a25; --ok-weak:#e2f2cc; --bad:#c23b28; --bad-weak:#fbdcd2; --gold:#a96a12; --gold-weak:#fdecc4;
      --top:#23336b; --top-text:#fff3d6;
      --shadow:0 3px 0 var(--line);
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth} [id]{scroll-margin-top:72px}
    body{margin:0;font:16px/1.5 "Baloo 2",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--text);
      background:radial-gradient(900px 500px at 50% -120px,#4f73c4 0%,transparent 70%),linear-gradient(180deg,#2c4180 0%,#1d2a55 60%,#161f42 100%) fixed;background-color:var(--bg);min-height:100vh}
    a{color:#b45d0e;font-weight:600}

    .top{background:linear-gradient(180deg,#30478c,#23336b);color:var(--top-text);position:sticky;top:0;z-index:10;border-bottom:3px solid #f2b13c;box-shadow:0 4px 12px rgba(0,0,0,.35)}
    .top .wrap{display:flex;align-items:center;gap:14px;padding-top:8px;padding-bottom:8px;flex-wrap:wrap;margin:0 auto;border:0;background:none;box-shadow:none}
    .brand{font-weight:800;font-size:20px;color:#ffd257;text-decoration:none;margin-right:6px;text-shadow:0 2px 0 #7a3f0a}
    nav{display:flex;gap:6px;flex-wrap:wrap}
    nav a{color:#fff3d6;text-decoration:none;padding:4px 14px;border-radius:10px;font-size:15px;font-weight:700;
      background:linear-gradient(180deg,#a8763f,#7d5126);border:2px solid #4b2d10;box-shadow:0 3px 0 #4b2d10;text-shadow:0 1px 0 #4b2d10}
    nav a:hover{filter:brightness(1.1)}
    nav a.active{background:linear-gradient(180deg,#ffc94a,#f0901f);border-color:#8a4a0c;box-shadow:0 3px 0 #8a4a0c;color:#fff;text-shadow:0 1px 0 #8a4a0c}

    .wrap{max-width:760px;margin:0 auto;padding:20px 16px}
    .wrap.wide{max-width:1080px}
    main.wrap{margin:20px auto 40px;background:var(--panel);border:4px solid var(--frame);border-radius:18px;
      box-shadow:inset 0 0 0 3px #f8ebcb,0 6px 0 var(--frame-dark),0 14px 30px rgba(0,0,0,.45)}
    @@media (max-width:820px){main.wrap{margin:12px 8px 28px;border-width:3px}}

    h1{margin:-20px -16px 16px;padding:10px 16px 12px;font-size:26px;line-height:1.2;font-weight:800;text-align:center;color:#fff;
      background:linear-gradient(180deg,#ffd45e 0%,#f6a733 55%,#ea8a1e 100%);border-bottom:3px solid var(--frame);border-radius:13px 13px 0 0;
      text-shadow:0 2px 0 #8a4a0c,0 0 2px #8a4a0c}
    h2{font-size:19px;margin:0 0 12px;font-weight:800;color:var(--frame-dark)}
    h3{font-size:17px;margin:16px 0 8px;font-weight:800;color:var(--frame-dark)}
    .card > h2:first-child{margin:-16px -16px 14px;padding:6px 14px;border-radius:11px 11px 0 0;text-align:center;
      background:linear-gradient(180deg,#f2c77a,#e2a957);border-bottom:2px solid var(--frame);color:var(--frame-dark)}

    table{border-collapse:separate;border-spacing:0;width:100%;margin:12px 0;background:var(--surface);border:2px solid var(--line);border-radius:12px;overflow:hidden}
    th,td{border-bottom:1px dashed var(--line);padding:7px 10px;text-align:left}
    tr:last-child td{border-bottom:0}
    th{font-size:13px;color:var(--frame-dark);font-weight:800;background:#ecd3a3;border-bottom:2px solid var(--line)}
    label{display:block;font-size:14px;font-weight:700;color:var(--muted);margin:12px 0 4px}
    input,select{font:inherit;font-weight:600;color:var(--text);background:#fffaf0;padding:7px 11px;width:100%;border:2px solid #d2ab74;border-radius:10px;outline:none;
      box-shadow:inset 0 2px 0 rgba(138,90,43,.12);transition:border-color .15s,box-shadow .15s}
    input:focus,select:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-weak)}
    button,.btn{font:inherit;font-size:17px;font-weight:800;padding:8px 22px;cursor:pointer;margin-top:14px;color:#fff;border-radius:12px;
      background:linear-gradient(180deg,#9be35f 0%,#5bb83a 55%,#45a02b 100%);border:2px solid #2d6a1a;box-shadow:0 4px 0 #2d6a1a;text-shadow:0 1px 0 #2d6a1a;
      transition:transform .05s,box-shadow .05s,filter .15s}
    button:hover{filter:brightness(1.06)}
    button:active{transform:translateY(3px);box-shadow:0 1px 0 #2d6a1a}
    .lack{color:var(--bad);font-weight:700} .have{color:var(--ok);font-weight:700}
    td.num,th.num{text-align:right;font-variant-numeric:tabular-nums}
    .star{width:28px;height:28px;object-fit:contain;vertical-align:middle;margin-right:2px} .stars{display:inline-block;min-height:28px}
    .card{background:var(--surface);border:2px solid var(--line);border-radius:14px;padding:16px;box-shadow:var(--shadow)}
    .ic{width:28px;height:28px;object-fit:contain;vertical-align:middle;margin-right:6px}
    .note,.muted{color:var(--muted);font-size:15px}
    .scroll{overflow-x:auto}
    @@media (max-width:560px){
      main.wrap{padding:16px 10px}
      main.wrap > h1{margin:-16px -10px 14px;font-size:23px}
      .card{padding:12px}
      .card > h2:first-child{margin:-12px -12px 12px}
    }
  </style>
  @await RenderSectionAsync("Head", required: false)
</head>
<body>
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    string Act(string c) => c == ctrl ? "active" : "";
}
<header class="top">
  <div class="wrap @(ViewData["Wide"] is true ? "wide" : "")">
    <a class="brand" asp-controller="Squad" asp-action="Index">Top Heroes Tool</a>
    <nav>
      <a class="@Act("Squad")" asp-controller="Squad" asp-action="Index">Thí Luyện</a>
      <a class="@Act("Heroes")" asp-controller="Heroes" asp-action="Index">Tướng & Trang bị</a>
      <a class="@Act("Brilliance")" asp-controller="Brilliance" asp-action="Index">Quang Huy</a>
    </nav>
  </div>
</header>
<main class="wrap @(ViewData["Wide"] is true ? "wide" : "")">
@RenderBody()
</main>
</body>
</html>
