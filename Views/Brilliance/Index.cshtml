@model BrillianceVm
@{
    ViewData["Wide"] = true;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var res = Model.Table.Resources;
    var tiers = Model.Table.Rows.GroupBy(r => BrillianceVm.TierOf(r.Level)).ToList();
    string Badge(int tier) => $"/images/brilliance/b{tier}.png";
    string N(long v) => v.ToString("N0", inv);
    int reachTier = Model.Reach is { } rr ? BrillianceVm.TierAt(rr.Level) : -1;
}
@section Head {
<style>
    .page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:16px}
    .tiers{display:grid;grid-template-columns:repeat(8,1fr);gap:8px;margin-bottom:20px}
    .tier{display:flex;flex-direction:column;align-items:center;gap:2px;padding:10px 4px;border-radius:12px;background:var(--surface);border:1px solid var(--line);text-decoration:none;color:var(--text);transition:transform .15s,border-color .15s}
    .tier:hover{transform:translateY(-2px);border-color:var(--accent)}
    .tier img{width:40px;height:40px;object-fit:contain}
    .tier b{font-size:13px} .tier small{font-size:11px;color:var(--muted)}
    .tier.done{background:var(--accent-weak);border-color:color-mix(in srgb,var(--accent) 40%,transparent)}
    .tier.now{outline:2px solid var(--accent);outline-offset:1px}
    @@media (max-width:640px){.tiers{grid-template-columns:repeat(4,1fr)}}

    .cols{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:16px;align-items:start;margin-bottom:16px}
    @@media (max-width:820px){.cols{grid-template-columns:1fr}}
    .card h2{display:flex;align-items:center;gap:8px}
    .card h2 .step{display:inline-grid;place-items:center;width:24px;height:24px;border-radius:50%;background:var(--accent);color:var(--accent-text);font-size:13px}

    .res-input{display:grid;grid-template-columns:30px 1fr minmax(0,1.3fr);align-items:center;gap:8px;padding:6px 0;border-bottom:1px dashed var(--line)}
    .res-input:last-child{border-bottom:0}
    .res-input img{width:30px;height:30px;object-fit:contain}
    .res-input span{font-weight:600}
    .res-input input{text-align:right;font-variant-numeric:tabular-nums}

    .placeholder{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;min-height:260px;color:var(--muted)}
    .placeholder img{width:72px;height:72px;opacity:.35;filter:grayscale(1);margin-bottom:10px}

    .hero{display:flex;align-items:center;gap:16px;padding:16px;border-radius:12px;background:linear-gradient(135deg,var(--gold-weak),var(--accent-weak))}
    .hero img{width:84px;height:84px;object-fit:contain;filter:drop-shadow(0 4px 8px rgba(0,0,0,.18))}
    .eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);font-weight:600}
    .hero-title{font-size:26px;font-weight:800;line-height:1.2}
    .chip{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;font-size:13px;font-weight:600;margin-top:10px}
    .chip img{width:20px;height:20px;object-fit:contain}
    .chip.warn{background:var(--bad-weak);color:var(--bad)} .chip.ok{background:var(--ok-weak);color:var(--ok)}
    .progress{margin-top:14px}
    .progress .bar{height:8px;border-radius:999px;background:var(--line);overflow:hidden}
    .progress .bar i{display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--gold))}
    .progress .lbl{display:flex;justify-content:space-between;font-size:13px;color:var(--muted);margin-bottom:6px}
    .rtable td:first-child{white-space:nowrap}

    .cost-form{display:grid;grid-template-columns:1fr 1fr auto;gap:12px;align-items:end}
    .cost-form label{margin-top:0} .cost-form button{margin-top:0}
    @@media (max-width:560px){.cost-form{grid-template-columns:1fr 1fr}.cost-form button{grid-column:1/-1}}
    .cost-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin-top:14px}
    .cost-item{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;background:var(--surface-2);border:1px solid var(--line)}
    .cost-item img{width:32px;height:32px;object-fit:contain}
    .cost-item small{display:block;color:var(--muted);font-size:12px}
    .cost-item strong{font-variant-numeric:tabular-nums;font-size:16px}
    .reqs{margin:12px 0 0;padding-left:18px;color:var(--muted);font-size:14px}

    .brl{margin:0;font-size:14px}
    .brl th,.brl td{padding:7px 10px;white-space:nowrap}
    .brl thead th{position:sticky;top:0;background:var(--surface);z-index:1}
    .brl thead th img{width:22px;height:22px;object-fit:contain;vertical-align:middle;margin-right:4px}
    .brl tr.grp td{background:var(--surface-2);border-top:2px solid var(--line);white-space:normal}
    .brl tr.grp img{width:34px;height:34px;object-fit:contain;vertical-align:middle;margin-right:8px}
    .brl tr.grp .req{display:block;color:var(--muted);font-size:13px;margin-left:42px}
    .brl tr.ms td{background:var(--gold-weak);font-weight:600}
    .brl tr.sub td{font-weight:700;color:var(--accent)}
    .brl tr.total td{background:var(--top);color:var(--top-text);font-weight:700}
    .tag{display:inline-block;margin-left:6px;padding:1px 8px;border-radius:999px;background:var(--gold);color:#fff;font-size:11px;font-weight:700;vertical-align:1px}
    .brl tr:hover td{filter:brightness(.98)}
</style>
}

<h1>@Model.Table.Name</h1>
<div class="page-head">
    <div>
        <div class="muted">Cấp thành @Model.MinLevel → @Model.MaxLevel · @tiers.Count bậc Quang Huy, mỗi bậc 5 cấp</div>
    </div>
</div>

<div class="tiers">
    @foreach (var grp in tiers)
    {
        int t = grp.Key;
        <a class="tier @(t <= reachTier ? "done" : "") @(t == reachTier ? "now" : "")" href="#b@(t)">
            <img src="@Badge(t)" alt="" />
            <b>Quang Huy @t</b>
            <small>Cấp @grp.First().Level–@grp.Last().Level</small>
        </a>
    }
</div>

<div class="cols" id="uoc-tinh">
    <section class="card">
        <h2><span class="step">1</span> Nhập số đang có</h2>
        <form method="get" action="#uoc-tinh" class="est">
            <input type="hidden" name="from" value="@Model.From" />
            <input type="hidden" name="to" value="@Model.To" />
            <label for="cur">Cấp thành hiện tại</label>
            <select id="cur" name="cur">
                @for (int l = Model.MinLevel; l < Model.MaxLevel; l++)
                {
                    int tier = BrillianceVm.TierAt(l);
                    <option value="@l" selected="@(l == Model.Cur)">Cấp @l@(tier > 0 ? $" · Quang Huy {tier}" : "")</option>
                }
            </select>

            <label>Nguyên liệu</label>
            @for (int i = 0; i < res.Count; i++)
            {
                long? have = i < Model.Own.Count ? Model.Own[i] : null;
                <div class="res-input">
                    @if (res[i].Icon != null) { <img src="@res[i].Icon" alt="" /> } else { <i></i> }
                    <span>@res[i].Name</span>
                    <input name="own" type="text" inputmode="numeric" class="money" placeholder="0" aria-label="@res[i].Name" value="@(have?.ToString("N0", inv))" />
                </div>
            }
            <button type="submit">Ước tính</button>
        </form>
    </section>

    <section class="card">
        <h2><span class="step">2</span> Kết quả</h2>
        @if (Model.Reach is { } g)
        {
            int tier = BrillianceVm.TierAt(g.Level);
            <div class="hero">
                @if (tier > 0) { <img src="@Badge(tier)" alt="" /> }
                <div>
                    <div class="eyebrow">Lên được</div>
                    <div class="hero-title">@(tier > 0 ? $"Quang Huy cấp {tier}" : "Chưa lên Quang Huy")</div>
                    <div class="muted">Cấp thành @Model.Cur → <strong>@g.Level</strong></div>
                </div>
            </div>

            @if (g.LimitingIndex is int k)
            {
                var lim = res[k];
                <span class="chip warn">
                    Dừng vì thiếu
                    @if (lim.Icon != null) { <img src="@lim.Icon" alt="" /> }
                    @lim.Name
                </span>
            }
            else if (g.OutOfData)
            {
                <span class="chip ok">Đủ lên tối đa cấp thành @Model.MaxLevel</span>
            }

            @if (Model.NextTierLevel is int next)
            {
                int nextTier = BrillianceVm.TierAt(next);
                int start = next - 5;
                int pct = (g.Level - start) * 100 / 5;
                <div class="progress">
                    <div class="lbl"><span>Tiến độ lên Quang Huy @nextTier</span><span>Cấp @g.Level / @next</span></div>
                    <div class="bar"><i style="width:@(pct)%"></i></div>
                </div>
            }

            <table class="rtable">
                <thead>
                    <tr>
                        <th>Nguyên liệu</th><th class="num">Sẽ dùng</th><th class="num">Còn lại</th>
                        @if (Model.NextTierLevel is int nl) { <th class="num">Thiếu cho QH @BrillianceVm.TierAt(nl)</th> }
                    </tr>
                </thead>
                @for (int i = 0; i < res.Count; i++)
                {
                    <tr>
                        <td>
                            @if (res[i].Icon != null) { <img class="ic" src="@res[i].Icon" alt="" /> }
                            @res[i].Name
                        </td>
                        <td class="num">@N(g.Spent[i])</td>
                        <td class="num">@N(g.Remaining[i])</td>
                        @if (Model.NextTierLack is { } lack)
                        {
                            <td class="num">
                                @if (lack[i] > 0) { <span class="lack">@N(lack[i])</span> }
                                else { <span class="have">Đủ</span> }
                            </td>
                        }
                    </tr>
                }
            </table>
        }
        else
        {
            <div class="placeholder">
                <img src="@Badge(1)" alt="" />
                <div>Nhập số nguyên liệu đang có rồi bấm <strong>Ước tính</strong><br />để xem lên được Quang Huy cấp mấy.</div>
            </div>
        }
    </section>
</div>

<section class="card" id="chi-phi" style="margin-bottom:16px">
    <h2>Chi phí nâng cấp</h2>
    <form method="get" action="#chi-phi" class="cost-form">
        <input type="hidden" name="cur" value="@Model.Cur" />
        @foreach (var o in Model.Own) { <input type="hidden" name="own" value="@o" /> }
        <div>
            <label for="from">Từ cấp thành</label>
            <select id="from" name="from">
                @for (int l = Model.MinLevel; l < Model.MaxLevel; l++)
                {
                    int tier = BrillianceVm.TierAt(l);
                    <option value="@l" selected="@(l == Model.From)">Cấp @l@(tier > 0 ? $" · QH {tier}" : "")</option>
                }
            </select>
        </div>
        <div>
            <label for="to">Lên cấp thành</label>
            <select id="to" name="to">
                @for (int l = Model.MinLevel + 1; l <= Model.MaxLevel; l++)
                {
                    int tier = BrillianceVm.TierAt(l);
                    <option value="@l" selected="@(l == Model.To)">Cấp @l@(tier > 0 ? $" · QH {tier}" : "")</option>
                }
            </select>
        </div>
        <button type="submit">Tính chi phí</button>
    </form>

    @if (Model.Cost is { } c)
    {
        <div class="cost-list">
            @for (int i = 0; i < res.Count; i++)
            {
                <div class="cost-item">
                    @if (res[i].Icon != null) { <img src="@res[i].Icon" alt="" /> }
                    <div><small>@res[i].Name</small><strong>@N(c.Totals[i])</strong></div>
                </div>
            }
        </div>
        var reqs = c.Steps.Where(s => s.Requires != null).ToList();
        if (reqs.Count > 0)
        {
            <ul class="reqs">
                @foreach (var s in reqs) { <li>Cấp @s.Level cần: @s.Requires</li> }
            </ul>
        }
    }
</section>

<section class="card">
    <h2>Bảng chi phí</h2>
    <div class="scroll">
        <table class="brl">
            <thead>
                <tr>
                    <th>Cấp thành</th>
                    @foreach (var r in res)
                    {
                        <th class="num">@if (r.Icon != null) { <img src="@r.Icon" alt="" /> }@r.Name</th>
                    }
                </tr>
            </thead>
            @foreach (var grp in tiers)
            {
                var first = grp.First();
                <tr class="grp" id="b@(grp.Key)">
                    <td colspan="@(res.Count + 1)">
                        <img src="@Badge(grp.Key)" alt="" /><strong>Quang Huy cấp @grp.Key</strong>
                        <span class="muted"> · cấp thành @first.Level–@grp.Last().Level</span>
                        @if (first.Requires != null) { <span class="req">Cần: @first.Requires</span> }
                    </td>
                </tr>
                foreach (var row in grp)
                {
                    bool ms = row.Milestone != null;
                    <tr class="@(ms ? "ms" : "")">
                        <td>
                            Cấp @row.Level
                            @if (ms && row.Milestone!.Contains("+5")) { <span class="tag">+5 cấp tướng</span> }
                        </td>
                        @foreach (var v in row.Costs) { <td class="num">@N(v)</td> }
                    </tr>
                }
                <tr class="sub">
                    <td>Tổng QH @grp.Key</td>
                    @for (int i = 0; i < res.Count; i++) { <td class="num">@N(grp.Sum(r => r.Costs[i]))</td> }
                </tr>
            }
            <tr class="total">
                <td>Toàn bộ</td>
                @for (int i = 0; i < res.Count; i++) { <td class="num">@N(Model.Table.Rows.Sum(r => r.Costs[i]))</td> }
            </tr>
        </table>
    </div>
</section>

<script>
    document.querySelectorAll('.money').forEach(el => {
        const fmt = () => {
            const digits = el.value.replace(/\D/g, '');
            el.value = digits ? Number(digits).toLocaleString('en-US') : '';
        };
        el.addEventListener('input', fmt);
        fmt();
    });
    document.querySelector('form.est').addEventListener('submit', () =>
        document.querySelectorAll('.money').forEach(el => el.value = el.value.replace(/,/g, '')));
</script>
