@model GearVm
@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}
<h1>Nâng trang bị</h1>

<form method="get">
    <label>Loại trang bị</label>
    <select name="tableId" onchange="location.href = '?tableId=' + this.value + '&pieces=' + this.form.pieces.value">
        @foreach (var t in Model.Tables)
        {
            <option value="@t.Id" selected="@(t.Id == Model.Table.Id)">@t.Name</option>
        }
    </select>
    @if (!string.IsNullOrEmpty(Model.Table.Note))
    {
        <p class="note">@Model.Table.Note</p>
    }

    <label>Số món nâng cùng lúc</label>
    <select name="pieces">
        @for (int n = 1; n <= 4; n++)
        {
            <option value="@n" selected="@(n == Model.Pieces)">@n món</option>
        }
    </select>

    <h2>Tổng chi phí từ 0 đến @Model.MaxLevel @Model.Table.LevelLabel (@Model.Pieces món)</h2>
    <table>
        @for (int i = 0; i < Model.Table.Resources.Count; i++)
        {
            var res = Model.Table.Resources[i];
            <tr>
                <td>
                    @if (res.Icon != null)
                    {
                        <img class="ic" src="@res.Icon" alt="" />
                    }
                    @res.Name
                </td>
                <td class="num"><strong>@Model.Totals[i].ToString("N0", inv)</strong></td>
            </tr>
        }
    </table>

    <h2>Nhập số bạn đang có</h2>
    <label>Số @Model.Table.LevelLabel hiện tại</label>
    <input name="from" type="number" min="0" max="@Model.MaxLevel" value="@Model.From" />
    @if (Model.Table.ShowStars)
    {
        <div><span id="fromStars" class="stars"></span></div>
    }

    <table>
        <tr><th>Nguyên liệu</th><th>Đang có</th></tr>
        @for (int i = 0; i < Model.Table.Resources.Count; i++)
        {
            var res = Model.Table.Resources[i];
            long? have = i < Model.Own.Count ? Model.Own[i] : null;
            <tr>
                <td>
                    @if (res.Icon != null)
                    {
                        <img class="ic" src="@res.Icon" alt="" />
                    }
                    @res.Name
                </td>
                <td>
                    <input name="own" type="text" inputmode="numeric" class="money"
                           value="@(have?.ToString("N0", inv))" />
                </td>
            </tr>
        }
    </table>
    <button type="submit">Ước tính</button>
</form>

@if (Model.Reach is { } g)
{
    <div class="res">
        <strong>Từ @Model.From @Model.Table.LevelLabel, nâng cùng lúc @Model.Pieces món được tới @g.Level @Model.Table.LevelLabel.</strong>
        @if (Model.Table.ShowStars)
        {
            <div><span class="stars" data-n="@g.Level"></span></div>
        }
        @if (g.LimitingIndex is int k)
        {
            var lim = Model.Table.Resources[k];
            <div>
                Dừng vì thiếu
                @if (lim.Icon != null)
                {
                    <img class="ic" src="@lim.Icon" alt="" />
                }
                @lim.Name ở bước tiếp theo.
            </div>
        }
        else if (g.OutOfData)
        {
            <div>Đủ nguyên liệu để lên tối đa (@Model.MaxLevel @Model.Table.LevelLabel).</div>
        }
        <table>
            <tr><th>Nguyên liệu</th><th>Sẽ dùng</th><th>Còn lại</th></tr>
            @for (int i = 0; i < Model.Table.Resources.Count; i++)
            {
                var res = Model.Table.Resources[i];
                <tr>
                    <td>
                        @if (res.Icon != null)
                        {
                            <img class="ic" src="@res.Icon" alt="" />
                        }
                        @res.Name
                    </td>
                    <td class="num">@g.Spent[i].ToString("N0", inv)</td>
                    <td class="num">@g.Remaining[i].ToString("N0", inv)</td>
                </tr>
            }
        </table>
    </div>
}

<script>
    function stripCommas() {
        document.querySelectorAll('.money').forEach(el => el.value = el.value.replace(/,/g, ''));
    }

    document.querySelectorAll('.money').forEach(el => {
        const fmt = () => {
            const digits = el.value.replace(/\D/g, '');
            el.value = digits ? Number(digits).toLocaleString('en-US') : '';
        };
        el.addEventListener('input', fmt);
        fmt();
    });

    document.querySelector('form').addEventListener('submit', stripCommas);

    function renderStars(el, n) {
        if (!el) return;
        el.innerHTML = '';
        n = parseInt(n) || 0;
        const add = k => {
            const img = document.createElement('img');
            img.className = 'star';
            img.src = '/images/stars/star' + k + '.png';
            img.alt = '';
            el.appendChild(img);
        };
        for (let i = 0; i < Math.floor(n / 5); i++) add(5);
        if (n % 5) add(n % 5);
    }

    document.querySelectorAll('.stars[data-n]').forEach(el => renderStars(el, el.dataset.n));

    const fromInput = document.querySelector('input[name=from]');
    const fromStars = document.getElementById('fromStars');
    if (fromInput && fromStars) {
        renderStars(fromStars, fromInput.value);
        fromInput.addEventListener('input', () => renderStars(fromStars, fromInput.value));
    }
</script>
