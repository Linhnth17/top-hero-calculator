@{
    ViewData["Wide"] = true;
}
@section Head {
<style>
    /* Lời chào */
    .welcome{padding:18px 20px;border-radius:16px;
        background:radial-gradient(120% 140% at 0% 0%,#5b7fd6 0%,#3a56b0 45%,#2a3f8f 100%);color:#fff;border:2px solid #23336b;box-shadow:0 4px 0 #1a2756}
    .welcome h2{margin:0 0 4px;font-size:26px;color:#ffd257;text-shadow:0 2px 0 #7a3f0a}
    .welcome p{margin:0;font-size:16px;font-weight:600;opacity:.95}
    /* Nhân vật kèm bong bóng lời chúc */
    .wish-row{display:flex;align-items:center;gap:14px;margin-top:14px}
    .wish-row .mascot{width:104px;height:auto;flex:none;image-rendering:pixelated;
        filter:drop-shadow(0 4px 0 rgba(0,0,0,.25)) drop-shadow(0 6px 10px rgba(0,0,0,.3))}
    .wish-row .mascot.missing{display:none}
    .wish{position:relative;padding:8px 18px;border-radius:16px;font-size:18px;font-weight:800;
        background:linear-gradient(180deg,#ffc94a,#f0901f);border:2px solid #8a4a0c;box-shadow:0 3px 0 #8a4a0c;text-shadow:0 1px 0 #8a4a0c}
    .wish::before{content:"";position:absolute;left:-11px;top:50%;margin-top:-8px;border:8px solid transparent;border-right:10px solid #8a4a0c;border-left:0}
    .wish::after{content:"";position:absolute;left:-7px;top:50%;margin-top:-6px;border:6px solid transparent;border-right:8px solid #f6a733;border-left:0}
    @@media (max-width:560px){.welcome{text-align:center}.wish-row{justify-content:center}.wish-row .mascot{width:76px}.wish{font-size:16px;text-align:left}}

    /* Thẻ công cụ */
    .tools{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:18px}
    @@media (max-width:820px){.tools{grid-template-columns:1fr}}
    .tool{display:flex;flex-direction:column;text-decoration:none;color:var(--text);font-weight:600;background:#fffaf0;border:2px solid var(--line);
        border-radius:16px;box-shadow:0 4px 0 var(--line);overflow:hidden;transition:transform .15s,box-shadow .15s}
    .tool:hover{transform:translateY(-3px);box-shadow:0 7px 0 var(--line)}
    .tool .hd{display:flex;align-items:center;gap:10px;padding:10px 14px;background:linear-gradient(180deg,#f3d9a8,#e8c486);border-bottom:2px solid var(--line)}
    .tool .hd img{width:46px;height:46px;border-radius:10px;border:2px solid var(--frame);box-shadow:0 2px 0 var(--frame-dark);object-fit:contain;background:#e9cf9c}
    .tool .hd b{font-size:19px;color:var(--frame-dark);line-height:1.15}
    .tool ul{margin:10px 14px 0;padding-left:18px;font-size:15px;color:var(--text);flex:1}
    .tool li{margin-bottom:4px}
    .tool .go{margin:12px 14px 14px;padding:6px 0;text-align:center;border-radius:12px;color:#fff;font-weight:800;
        background:linear-gradient(180deg,#9be35f,#45a02b);border:2px solid #2d6a1a;box-shadow:0 3px 0 #2d6a1a;text-shadow:0 1px 0 #2d6a1a}

    .tip{margin-top:18px;padding:10px 14px;border-radius:12px;background:#fff4dc;border:2px dashed #e9a13c;font-size:15px;color:var(--frame-dark)}
</style>
}
<h1>Top Heroes Tool</h1>

<div class="welcome">
    <h2>Chào mừng các Lãnh Chúa!</h2>
    <p>Bộ công cụ nhỏ giúp bạn tính toán và lên kế hoạch trong Top Heroes: tối ưu điểm sự kiện,
        chọn trang bị cho tướng và tính tài nguyên nâng Quang Huy.</p>
    <div class="wish-row">
        <img class="mascot" src="/images/donate/mascot.png" alt="" onerror="this.classList.add('missing')" />
        <span class="wish">Chúc mọi người chơi game vui vẻ!</span>
    </div>
</div>

<div class="tools">
    <a class="tool" asp-controller="Squad" asp-action="Index">
        <div class="hd"><img src="/images/resources/res11.png" alt="" /><b>Xu Thiên Gươm</b></div>
        <ul>
            <li>Nhập cấp, sao trang bị của đội hình 6 tướng</li>
            <li>Gợi ý cách nâng để được nhiều điểm sự kiện nhất</li>
            <li>Xem mốc rương và điều kiện lên BXH</li>
        </ul>
        <span class="go">Tính điểm</span>
    </a>
    <a class="tool" asp-controller="Heroes" asp-action="Index">
        <div class="hd"><img src="/images/gear/weapon3.png" alt="" /><b>Tướng & Trang bị</b></div>
        <ul>
            <li>@ViewData["Sets"] bộ trang bị và chỉ số khi đủ bộ</li>
            <li>@ViewData["Heroes"] tướng kèm bộ nên dùng, bộ thay thế</li>
            <li>Lọc theo phe, theo bộ, tìm theo tên</li>
        </ul>
        <span class="go">Xem tướng</span>
    </a>
    <a class="tool" asp-controller="Brilliance" asp-action="Index">
        <div class="hd"><img src="/images/brilliance/b8.png" alt="" /><b>Quang Huy</b></div>
        <ul>
            <li>Chi phí nâng thành từ cấp 40 lên 80</li>
            <li>Ước tính lên được bậc Quang Huy mấy với tài nguyên đang có</li>
            <li>Nhà điều kiện cần có ở từng mốc</li>
        </ul>
        <span class="go">Tính Quang Huy</span>
    </a>
</div>

<p class="tip">Số liệu sự kiện có thể thay đổi giữa các đợt và các server. Nếu thấy chỗ nào chưa khớp với game, hãy báo để mình cập nhật nhé.</p>
